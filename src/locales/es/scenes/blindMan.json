{
  "storyTitle": "El Ciego de Nacimiento",
  "start": {
    "title": "¿Quién Pecó?",
    "text": "Te sientas en el polvo, mendigando.\nLos discípulos preguntan: «¿Quién pecó?»",
    "choices": [
      {
        "text": "Maldícelos en silencio",
        "feedback": "Escucha en su lugar."
      },
      {
        "text": "Espera y escucha",
        "feedback": "Te quedas quieta."
      },
      {
        "text": "Ruégales más fuerte",
        "feedback": "Quédate quieta y escucha."
      }
    ]
  },
  "curse_consequence": {
    "title": "Quédate Quieto",
    "text": "La ira no te sanará.\nEscucha.",
    "choices": [
      {
        "text": "Espera y escucha",
        "feedback": "Aquietas tu corazón."
      }
    ]
  },
  "beg_consequence": {
    "title": "Silencio Ahora",
    "text": "Una voz les responde.\nEscucha.",
    "choices": [
      {
        "text": "Espera y escucha",
        "feedback": "Inclinas la cabeza."
      }
    ]
  },
  "reveal": {
    "title": "Las Obras de Dios Reveladas",
    "text": "«Ni este hombre ni sus padres».\n«Las obras de Dios se manifestarán».",
    "choices": [
      {
        "text": "Duda de sus palabras",
        "feedback": "Aférrate a la esperanza."
      },
      {
        "text": "Espera en silencio",
        "feedback": "Algo se agita."
      }
    ]
  },
  "doubt_consequence": {
    "title": "Aguanta",
    "text": "Su voz es amable.\nTen un poco de esperanza.",
    "choices": [
      {
        "text": "Espera en silencio",
        "feedback": "Inspiras."
      }
    ]
  },
  "mud": {
    "title": "Barro en Tus Ojos",
    "text": "Escupe en el suelo, hace barro.\nSu mano encuentra tu rostro.",
    "choices": [
      {
        "text": "Aléjate con miedo",
        "feedback": "Deja que te toque."
      },
      {
        "text": "Límpiatelo de inmediato",
        "feedback": "Confía en él."
      },
      {
        "text": "Quédate quieto bajo su mano",
        "feedback": "Arcilla fría reposa allí."
      }
    ]
  },
  "pull_consequence": {
    "title": "Quédate Quieto",
    "text": "Su toque es suave.\nDéjale trabajar.",
    "choices": [
      {
        "text": "Quédate quieto bajo su mano",
        "feedback": "Esperas."
      }
    ]
  },
  "wipe_consequence": {
    "title": "Confía en Su Mano",
    "text": "No deshagas Su obra.\nEspera.",
    "choices": [
      {
        "text": "Quédate quieto bajo su mano",
        "feedback": "La arcilla permanece."
      }
    ]
  },
  "send": {
    "title": "Ve a Siloé",
    "text": "«Ve, lávate en el estanque de Siloé».\nEl camino es largo.",
    "choices": [
      {
        "text": "Quédate donde estás a salvo",
        "feedback": "Obedécele."
      },
      {
        "text": "Camina hacia la piscina",
        "feedback": "Sientes la pared y avanzas."
      }
    ]
  },
  "stay_consequence": {
    "title": "Obedece",
    "text": "El estanque espera.\nCamina.",
    "choices": [
      {
        "text": "Camina hacia la piscina",
        "feedback": "Sales a la calle."
      }
    ]
  },
  "wash": {
    "title": "El Estanque de Siloé",
    "text": "Agua en tus manos.\nTe la llevas a los ojos.",
    "choices": [
      {
        "text": "Lávate y alza los ojos",
        "feedback": "La luz inunda."
      },
      {
        "text": "Lávate y mantenlos cerrados",
        "feedback": "Ábrelos."
      }
    ]
  },
  "shut_consequence": {
    "title": "Abre los ojos",
    "text": "Él te envió a ver.\nLevántalos.",
    "choices": [
      {
        "text": "Lávate y alza los ojos",
        "feedback": "La luz inunda."
      }
    ]
  },
  "see": {
    "title": "Puedes ver",
    "text": "Cielo. Piedra. Tus propias manos.\nLloras, riendo.",
    "choices": [
      {
        "text": "Escóndelo de la multitud",
        "feedback": "Díselo."
      },
      {
        "text": "Díselo a todo el que encuentres",
        "feedback": "Tu voz se alza."
      }
    ]
  },
  "hide_consequence": {
    "title": "Habla",
    "text": "No escondas su obra.\nDíselo.",
    "choices": [
      {
        "text": "Díselo a todo el que encuentres",
        "feedback": "Corres a la calle."
      }
    ]
  },
  "pharisees": {
    "title": "Los fariseos te interrogan",
    "text": "Te miran con desprecio. «¿Quién te abrió los ojos?»\nLa habitación está fría.",
    "choices": [
      {
        "text": "Miente para mantener la paz",
        "feedback": "Di la verdad."
      },
      {
        "text": "«Un hombre llamado Jesús»",
        "feedback": "Tu voz es firme."
      },
      {
        "text": "Permanece en silencio por miedo",
        "feedback": "Habla."
      }
    ]
  },
  "lie_consequence": {
    "title": "Di la verdad",
    "text": "La verdad te hizo libre.\nNómbrale.",
    "choices": [
      {
        "text": "«Un hombre llamado Jesús»",
        "feedback": "Te pones de pie."
      }
    ]
  },
  "silent_consequence": {
    "title": "Encuentra tu voz",
    "text": "Él te dio la vista.\nDale tus palabras.",
    "choices": [
      {
        "text": "«Un hombre llamado Jesús»",
        "feedback": "Hablas con claridad."
      }
    ]
  },
  "testify": {
    "title": "Una cosa sé",
    "text": "«Yo era ciego. Ahora veo.»\nLa luz permanece contigo.",
    "choices": []
  }
