        "text": "Przynieś wieść Maryi",
        "feedback": "Słucha łagodnie."
      }
    ]
  },
  "pretend_consequence": {
    "title": "Mów",
    "text": "Goście zauważą.\nNie udawaj.",
    "choices": [
      {
        "text": "Przynieś wieść Maryi",
        "feedback": "Ona zwraca się do swojego syna."
      }
    ]
  },
  "mother": {
    "title": "Głos Jego Matki",
    "text": "„Nie mają już wina” – mówi.\nPotem zwraca się do ciebie.",
    "choices": [
      {
        "text": "Czekaj na jasne rozkazy",
        "feedback": "Słuchaj uważnie."
      },
      {
        "text": "„Zróbcie wszystko, co wam powie.”",
        "feedback": "Jej zaufanie cię umacnia."
      }
    ]
  },
  "wait_consequence": {
    "title": "Zaufaj Jej Słowom",
    "text": "Ona już przemówiła.\nBądź posłuszny jej synowi.",
