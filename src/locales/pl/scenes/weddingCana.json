        "text": "Zapytaj dlaczego — to tylko woda",
        "feedback": "Najpierw bądź posłuszny."
      },
      {
        "text": "Weź tylko jeden dzban",
        "feedback": "Napełnij je wszystkie."
      },
      {
        "text": "Napełnij każdy dzban po brzegi",
        "feedback": "Pełne posłuszeństwo."
