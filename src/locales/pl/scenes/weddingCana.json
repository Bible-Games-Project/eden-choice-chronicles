        "feedback": "Ciepło cię ogarnia."
      }
    ]
  },
  "shortage": {
    "title": "Ostatni Kielich",
    "text": "Rozchodzą się szepty: wina zabrakło.\nOczy Maryi odnajdują jej syna.",
    "choices": [
      {
        "text": "Ukryj puste dzbany",
        "feedback": "Prawda jest lepsza."
      },
      {
        "text": "Udawaj, że nic się nie stało",
        "feedback": "Nie ukrywaj tego."
      },
      {
        "text": "Przynieś wieść Maryi",
        "feedback": "Ona będzie wiedziała."
      }
    ]
  },
  "hide_consequence": {
