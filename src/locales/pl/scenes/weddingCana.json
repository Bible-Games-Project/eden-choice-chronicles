{
  "storyTitle": "Wesele w Kanie",
  "start": {
    "title": "Radosna Uczta",
    "text": "Latarnie kołyszą się. Śmiech narasta.\nPanna młoda i pan młody tańczą.",
    "choices": [
      {
        "text": "Dołącz do tańca",
        "feedback": "Radość należy do wszystkich."
      },
      {
        "text": "Wyślizgnij się z hałasu",
        "feedback": "Zostań. Bądź obecny."
      }
    ]
  },
  "slip_consequence": {
    "title": "Powrót",
    "text": "Uczta wciąż cię wzywa.\nWróć.",
