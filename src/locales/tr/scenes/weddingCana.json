      {
        "text": "Neden diye sor — o sadece su",
        "feedback": "Önce itaat et."
      },
      {
        "text": "Sadece bir testi al",
        "feedback": "Hepsini doldur."
      },
      {
        "text": "Her testiyi ağzına kadar doldur",
        "feedback": "Yuhanna 2:6-7 — İsa hizmetkarlara altı taş küpü suyla doldurmalarını söyledi."
      }
    ]
