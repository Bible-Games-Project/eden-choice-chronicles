{
  "storyTitle": "Kana'daki Düğün",
  "start": {
    "title": "Neşeli Bir Ziyafet",
    "text": "Fenerler sallanıyor. Kahkahalar yükseliyor.\nGelin ve damat dans ediyor.",
    "choices": [
      {
        "text": "Dans etmeye katıl",
        "feedback": "Yuhanna 2:1-2 — İsa ve öğrencileri Kana'daki düğüne davet edildiler."
      },
      {
        "text": "Gürültüden sıyrıl",
        "feedback": "Kal. Mevcut ol."
      }
    ]
  },
  "slip_consequence": {
    "title": "Geri Dön",
    "text": "Ziyafet hala seni çağırıyor.\nGeri dön.",
    "choices": [
      {
        "text": "Dans etmeye katıl",
        "feedback": "Sıcaklık seni karşılar."
      }
    ]
  },
  "shortage": {
    "title": "Son Kadeh",
    "text": "Fısıltılar yayılıyor: şarap bitti.\nMeryem'in gözleri oğlunu buluyor.",
    "choices": [
      {
        "text": "Boş testileri sakla",
        "feedback": "Gerçek daha iyidir."
      },
      {
        "text": "Hiçbir şey yokmuş gibi yap",
        "feedback": "Saklama."
      },
      {
        "text": "Meryem'e haber ver",
        "feedback": "Yuhanna 2:3 — Meryem İsa'ya dedi ki: \"Şarapları kalmadı.\""
      }
    ]
  },
  "hide_consequence": {
    "title": "Ona Söyle",
    "text": "Utanç hiçbir şeyi çözmez.\nMeryem'i bul.",
    "choices": [
      {
        "text": "Meryem'e haber ver",
        "feedback": "Nazikçe dinler."
      }
    ]
  },
  "pretend_consequence": {
    "title": "Konuş",
    "text": "Misafirler fark edecek.\nNumara yapma.",
    "choices": [
      {
        "text": "Meryem'e haber ver",
        "feedback": "Oğluna döner."
      }
    ]
  },
  "mother": {
    "title": "Annesinin Sesi",
    "text": "\"Şarapları kalmamış,\" diyor.\nSonra sana dönüyor.",
    "choices": [
      {
        "text": "Açık emirleri bekle",
        "feedback": "Yakından dinle."
      },
      {
        "text": "\"Size ne derse onu yapın.\"",
        "feedback": "Yuhanna 2:5 — Meryem hizmetkarlara talimat verdi: \"Size ne derse onu yapın.\""
      }
    ]
  },
  "wait_consequence": {
    "title": "Sözlerine Güven",
    "text": "O zaten konuştu.\nOğluna itaat et.",
    "choices": [
      {
        "text": "\"Size ne derse onu yapın.\"",
        "feedback": "Başını eğersin."
      }
    ]
  },
  "instruct": {
    "title": "Sessiz Bir Emir",
    "text": "İsa altı taş küpü işaret ediyor.\n\"Onları suyla doldurun.\"",
