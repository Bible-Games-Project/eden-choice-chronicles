{
  "storyTitle": "Doğuştan Kör Adam",
  "start": {
    "title": "Kim Günah İşledi?",
    "text": "Toz içinde oturmuş, yalvarıyorsun.\nÖğrenciler sorar, \"Kim günah işledi?\"",
    "choices": [
      {
        "text": "Onlara sessizce lanet et",
        "feedback": "Bunun yerine dinle."
      },
      {
        "text": "Bekle ve dinle",
        "feedback": "Sakin kalırsın."
      },
      {
        "text": "Onlara daha yüksek sesle yalvar",
        "feedback": "Sakin ol ve dinle."
      }
    ]
  },
  "curse_consequence": {
    "title": "Sakin Ol",
    "text": "Öfke seni iyileştirmez.\nDinle.",
    "choices": [
      {
        "text": "Bekle ve dinle",
        "feedback": "Yüreğini susturursun."
      }
    ]
  },
  "beg_consequence": {
    "title": "Şimdi Sessiz Ol",
    "text": "Bir ses onlara cevap verir.\nDinle.",
    "choices": [
      {
        "text": "Bekle ve dinle",
        "feedback": "Başını eğersin."
      }
    ]
  },
  "reveal": {
    "title": "Tanrı'nın İşleri Açığa Çıktı",
    "text": "\"Ne bu adam ne de anne babası.\"\n\"Tanrı'nın işleri görülecek.\"",
    "choices": [
      {
        "text": "Sözlerinden şüphe et",
        "feedback": "Umuda tutun."
      },
      {
        "text": "Sessizce umut et",
        "feedback": "Bir şeyler kıpırdanır."
      }
    ]
  },
  "doubt_consequence": {
    "title": "Dayan",
    "text": "Sesi nazik.\nBiraz umutlan.",
