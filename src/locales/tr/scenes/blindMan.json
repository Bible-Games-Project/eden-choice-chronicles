    "text": "Yere tükürür, çamur yapar.\nEli yüzünü bulur.",
    "choices": [
      {
        "text": "Korkuyla uzaklaş",
        "feedback": "Sana dokunmasına izin ver."
      },
      {
        "text": "Hemen sil",
