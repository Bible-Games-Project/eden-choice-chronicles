{
  "storyTitle": "Yair'in Kızı",
  "start": {
    "title": "Kıyıda",
    "text": "Öğretmen tekneden iner.\nKızın evde ölmek üzere.",
    "choices": [
      {
        "text": "Bunun yerine bir hizmetçi gönder",
        "feedback": "Kendin ona git."
      },
      {
        "text": "İhtiyacını ondan sakla",
        "feedback": "O kırıklar için geldi."
      },
      {
        "text": "Ayaklarına kapan, yalvar",
        "feedback": "Alçakgönüllü iman cenneti açar."
      }
    ]
  },
  "servant_consequence": {
    "title": "Kendin Git",
    "text": "Umidini başka kimse taşıyamaz.\nÖnünde diz çök.",
    "choices": [
      {
        "text": "Ayaklarına kapan, yalvar",
        "feedback": "Derin bir şekilde eğiliyorsun."
      }
    ]
  },
  "hide_consequence": {
    "title": "Kalbinizi Açın",
    "text": "O zaten üzüntünü görüyor.\nSesli söyle.",
