{
  "storyTitle": "Fırtınayı Dindirmek",
  "start": {
    "title": "Yola Çıkış",
    "text": "Akşam denize iniyor.\nİsa, \"Karşıya geçelim,\" diyor.",
    "choices": [
      {
        "text": "Reddet, hava kararır",
        "feedback": "Sözüne güven."
      },
      {
        "text": "Tekneyi suya itin",
        "feedback": "Onunla yelken açarsınız."
      },
      {
        "text": "Sabahı bekleyin",
        "feedback": "Şimdi sizi çağırıyor."
      }
    ]
  },
  "refuse_consequence": {
    "title": "O'nun Sözünü Takip Et",
    "text": "O'nun çağrısı bu gece için.\nO'nunla git.",
    "choices": [
      {
        "text": "Tekneyi suya itin",
        "feedback": "İtaat edersiniz."
      }
    ]
  },
  "wait_consequence": {
    "title": "Şimdi O'na Güven",
    "text": "Sahilde bekliyor.\nHiç gecikme.",
    "choices": [
      {
        "text": "Tekneyi suya itin",
        "feedback": "Yelken açarsınız."
      }
    ]
  },
  "storm": {
    "title": "Deniz Yükseliyor",
    "text": "Rüzgar yelkeni yırtıyor.\nDalgalar tekneye çarpıyor.",
    "choices": [
      {
        "text": "Rüzgara lanet okuyun",
        "feedback": "Öfke sizi kurtaramaz."
      },
      {
        "text": "Tüm gücünüzle kürek çekin",
        "feedback": "Kürekleri zorlarsınız."
      },
      {
        "text": "Denize atlayın",
        "feedback": "Teknede kalın."
      }
    ]
  },
  "curse_consequence": {
    "title": "Sakin Kal",
    "text": "Küfür etmek fırtınayı dindirmez.\nDiğerleriyle birlikte kürek çek.",
    "choices": [
      {
        "text": "Tüm gücünüzle kürek çekin",
        "feedback": "Kürekleri kavrarsınız."
      }
    ]
  },
  "leap_consequence": {
    "title": "O'nunla Kal",
    "text": "Deniz seni yutardı.\nTekneye geri dön.",
    "choices": [
      {
        "text": "Tüm gücünüzle kürek çekin",
        "feedback": "Sıkıca tutunursunuz."
      }
    ]
  },
  "sleep": {
    "title": "O Uyuyor",
    "text": "İsa teknenin kıçında uyuyor.\nFırtına şiddetleniyor.",
    "choices": [
      {
        "text": "Uyusun, tek başınıza panikleyin",
        "feedback": "O sizin yardımcınızdır."
      },
      {
        "text": "Bir çığlıkla uyandırın",
        "feedback": "Ona gidersiniz."
      }
    ]
  },
  "alone_consequence": {
    "title": "O'na Git",
    "text": "Tekneyi tek başına kurtaramazsın.\nRab'bini uyandır.",
    "choices": [
      {
        "text": "Bir çığlıkla uyandırın",
        "feedback": "Onu nazikçe sallarsınız."
      }
    ]
  },
  "wake": {
    "title": "O'nu Uyandır",
    "text": "Ne söyleyeceksin?\nSu hızla yükseliyor.",
    "choices": [
      {
        "text": "Fırtına için onu suçlayın",
        "feedback": "İhtiyaçtan konuşun."
      },
      {
        "text": "\"Ya Rab, bizi kurtar, yok oluyoruz!\"",
        "feedback": "Gözlerini açar."
      },
      {
        "text": "Korkuyla sessiz kalın",
        "feedback": "Ona seslenin."
      }
    ]
  },
  "blame_consequence": {
    "title": "Sor, Suçlama",
    "text": "O senin düşmanın değil.\nSeni kurtarmasını iste.",
    "choices": [
      {
        "text": "\"Ya Rab, bizi kurtar, yok oluyoruz!\"",
        "feedback": "Sakin bir şekilde kalkar."
      }
    ]
  },
  "silent_consequence": {
    "title": "O'na Haykır",
    "text": "Sessizlik denizi dindirmez.\nKonuş.",
    "choices": [
      {
        "text": "\"Ya Rab, bizi kurtar, yok oluyoruz!\"",
        "feedback": "Sizi duyar."
      }
    ]
  },
  "calm": {
    "title": "Sakin Ol, Durul",
    "text": "Ayağa kalkar ve elini kaldırır.\n\"Sakin olun. Durulun.\"",
    "choices": [
      {
        "text": "Gördüklerinizden şüphe edin",
        "feedback": "Gözlerinizi açın."
      },
      {
        "text": "Titreyen bir huşu içinde durun",
        "feedback": "Rüzgar ve dalgalar itaat eder."
      }
    ]
  },
  "doubt_consequence": {
    "title": "Gör ve İnan",
    "text": "Deniz cam gibi.\nHüşu ile dol.",
    "choices": [
      {
        "text": "Titreyen bir huşu içinde durun",
        "feedback": "Başınızı eğersiniz."
      }
    ]
  },
  "amaze": {
    "title": "Bu Kim?",
    "text": "Deniz duruldu.\n\"Rüzgar bile ona itaat ediyor.\"",
    "choices": []
  }
